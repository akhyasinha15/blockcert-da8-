[
  {
    "step": 1,
    "title": "Deploy DigitalIdentity (DA-1 Q2) and CertificateRegistry (DA-8)",
    "lines": [
      "$ forge create src/DigitalIdentity.sol:DigitalIdentity",
      "  Deployed to : 0x5FbDB2315678afecb367f032d93F642f64180aa3   [DigitalIdentity]",
      "  Tx hash     : 0x9444bb134cd7bb77ec93efd17b7e9a7b72640f68a5f6df1858061411f078ef49",
      "  Gas used    : 478154",
      "$ forge create src/CertificateRegistry.sol:CertificateRegistry",
      "  Deployed to : 0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512   [CertificateRegistry]",
      "  Tx hash     : 0x1a1c87b477254fc689bb7f8496324c7ececbe1d0bd36d2b43dfa51e275615ea0",
      "  Gas used    : 2211787",
      "$ cast call CertificateRegistry 'totalBlocks()(uint256)'",
      "  1   <- genesis block only"
    ]
  },
  {
    "step": 2,
    "title": "Identity layer: register the university registrar wallet",
    "lines": [
      "$ cast send DigitalIdentity 'registerUser(uint256,string,string)' 1 'Registrar Office' 'Academic Affairs'   --from REGISTRAR",
      "  status      : SUCCESS",
      "  block       : 3",
      "  tx hash     : 0xfe06e1fb809207163697fa2dcae670811cc6417d20a607d162dd0b87657f837b",
      "  gas used    : 138665",
      "  event       : UserRegistered",
      "$ cast call DigitalIdentity 'isWalletRegistered(address)(bool)' 0x70997970C51812dc3A010C7d01b50e0d17dc79C8",
      "  true",
      "$ cast call DigitalIdentity 'isWalletRegistered(address)(bool)' 0x15d34AAf54267DB7D7c367839AAf71A00a2C6A65",
      "  false"
    ]
  },
  {
    "step": 3,
    "title": "Access control: authorise issuers (identity check enforced)",
    "lines": [
      "$ cast send CertificateRegistry 'authorizeIssuer(address)' 0x15d34AAf54267DB7D7c367839AAf71A00a2C6A65   --from ADMIN",
      "  status      : REVERTED",
      "  reason      : Error: Issuer must have a registered digital identity.",
      "$ cast send CertificateRegistry 'authorizeIssuer(address)' 0x70997970C51812dc3A010C7d01b50e0d17dc79C8   --from ADMIN",
      "  status      : SUCCESS",
      "  block       : 4",
      "  tx hash     : 0xa5324a2ed066cbd75612a3922c9c452b6a3dfdfab29367632f8619af9ee3467b",
      "  gas used    : 50815",
      "  event       : IssuerAuthorized",
      "$ cast send CertificateRegistry 'issueCertificate(string,string,string,uint16,string)' CERT-999 MALLORY B.TECH 2027 QmFake   --from STRANGER",
      "  status      : REVERTED",
      "  reason      : Access Denied: Caller is not an authorised issuer."
    ]
  },
  {
    "step": 4,
    "title": "Issue certificates (each becomes a hash-linked block)",
    "lines": [
      "$ cast send CertificateRegistry 'issueCertificate(string,string,string,uint16,string)' CERT-101 ALICE 'B.TECH COMPUTER SCIENCE' 2027 QmadtCXH7euAdrDxxt7jzBNy5PWpP7YQb6JkqVmLU9BtUi   --from REGISTRAR",
      "  status      : SUCCESS",
      "  block       : 5",
      "  tx hash     : 0x3c3d7e58d142bc1e50266ea2d201c286e8f1aa5362f3dca9ffbfad4fca2a7b59",
      "  gas used    : 311250",
      "  event       : CertificateIssued",
      "      index        = 1",
      "      certId       = \"CERT-101\"",
      "      studentName  = \"ALICE\"",
      "      blockHash    = 0x0fec4ce87d3e59d7e29c697d58bb6d3c34f1f13b4d2ac3544f1acf820a239bc9",
      "      previousHash = 0x8229fdb3fd488fbbd969b0f6936b2957ae44145c2edcd0ba5b6cc563d5ada289",
      "      ipfsCid      = \"QmadtCXH7euAdrDxxt7jzBNy5PWpP7YQb6JkqVmLU9BtUi\"",
      "",
      "$ cast send CertificateRegistry 'issueCertificate(string,string,string,uint16,string)' CERT-102 BOB 'B.TECH COMPUTER SCIENCE' 2027 QmYkSpJyP6SeHcKMk4o15hQbi2tBREFmwxT7gKkPSqLn6E   --from REGISTRAR",
      "  status      : SUCCESS",
      "  block       : 6",
      "  tx hash     : 0xcbc3f8d01d0e3cc4d36fadfe5e2b58ba1000325f56b0e67f4ede2c2d72a65a55",
      "  gas used    : 311226",
      "  event       : CertificateIssued",
      "      index        = 2",
      "      certId       = \"CERT-102\"",
      "      studentName  = \"BOB\"",
      "      blockHash    = 0x566454e7df37025e93bb0fed74d88667f85dcc07b203f440f24dcb356704f70f",
      "      previousHash = 0x0fec4ce87d3e59d7e29c697d58bb6d3c34f1f13b4d2ac3544f1acf820a239bc9",
      "      ipfsCid      = \"QmYkSpJyP6SeHcKMk4o15hQbi2tBREFmwxT7gKkPSqLn6E\"",
      "$ cast send CertificateRegistry 'issueCertificate(string,string,string,uint16,string)' CERT-103 CHARLIE 'B.TECH CYBER SECURITY' 2027 QmR95Ed7EScrgwjLL3T2QBshZtpY2vBdunNYA8FTSoqAU9   --from REGISTRAR",
      "  status      : SUCCESS",
      "  block       : 7",
      "  tx hash     : 0xf690d10ff49f646355080628a3da5f26dfb84421b1a4b4cf4b0cd898cbd9debd",
      "  gas used    : 311250",
      "  event       : CertificateIssued",
      "$ cast send CertificateRegistry 'issueCertificate(string,string,string,uint16,string)' CERT-101 MALLORY 'B.TECH COMPUTER SCIENCE' 2027 QmDup   --from REGISTRAR",
      "  status      : REVERTED",
      "  reason      : Error: Certificate ID already exists!"
    ]
  },
  {
    "step": 5,
    "title": "Read the chain and verify certificates",
    "lines": [
      "$ cast call CertificateRegistry 'totalBlocks()(uint256)' ",
      "  4",
      "$ cast call CertificateRegistry 'getCertificate(string)' CERT-102",
      "  (\"CERT-102\", \"BOB\", \"B.TECH COMPUTER SCIENCE\", 2027, \"QmYkSpJyP6SeHcKMk4o15hQbi2tBREFmwxT7gKkPSqLn6E\", REGISTRAR, 0x566454e7df37025e93bb0fed74d88667f85dcc07b203f440f24dcb356704f70f, 0x0fec4ce87d3e59d7e29c697d58bb6d3c34f1f13b4d2ac3544f1acf820a239bc9, 1791794093 [1.791e9], false)",
      "$ cast call CertificateRegistry 'verifyCertificate(string,string,string,uint16)' CERT-102 BOB 'B.TECH COMPUTER SCIENCE' 2027",
      "  true",
      "  false",
      "  REGISTRAR",
      "  ^ authentic=true, revoked=false, issuer=REGISTRAR",
      "$ cast call CertificateRegistry 'verifyCertificate(string,string,string,uint16)' CERT-102 BOB 'B.TECH COMPUTER SCIENCE' 2030",
      "  false",
      "  false",
      "  REGISTRAR",
      "  ^ forged graduation year -> authentic=false",
      "$ cast call CertificateRegistry 'verifyChainIntegrity()' ",
      "  true",
      "  0"
    ]
  },
  {
    "step": 6,
    "title": "Revoke a certificate (history preserved, chain still valid)",
    "lines": [
      "$ cast send CertificateRegistry 'revokeCertificate(string,string)' CERT-103 'Degree withdrawn by academic council'   --from REGISTRAR",
      "  status      : SUCCESS",
      "  block       : 8",
      "  tx hash     : 0x79e596bef4051a1f50e45c9b6d3531c7b24e7b16fe709a2b3a43984e493905d6",
      "  gas used    : 38771",
      "  event       : CertificateRevoked",
      "$ cast call CertificateRegistry 'verifyCertificate(string,string,string,uint16)' CERT-103 CHARLIE 'B.TECH CYBER SECURITY' 2027",
      "  true",
      "  true",
      "  REGISTRAR",
      "  ^ authentic=true (record intact), revoked=true",
      "$ cast call CertificateRegistry 'verifyChainIntegrity()' ",
      "  true",
      "  0"
    ]
  },
  {
    "step": 7,
    "title": "Tamper detection on a corrupted copy of the registry (test harness)",
    "lines": [
